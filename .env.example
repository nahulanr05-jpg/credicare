# Database: SQLite by default for zero-friction setup.
# To switch to PostgreSQL, change provider to "postgresql" in prisma/schema.prisma and use:
# DATABASE_URL="postgresql://user:password@localhost:5432/financial_firewall?schema=public"
DATABASE_URL="file:./dev.db"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="financial-firewall-super-secret-key-production-ready-2026"

# Optional OpenAI or compatible API (DeepSeek, Groq, local Ollama, etc.)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"
